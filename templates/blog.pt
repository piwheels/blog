<div metal:use-macro="layout">
  <div metal:fill-slot="head" tal:omit-tag="1">
    <meta name="description" content="piwheels blog" />
    <meta property="og:url" content="${site.config.base_url}/${link}" />
    <meta property="og:title" content="${title}" />
    <meta property="og:description" content="piwheels blog" />
    <meta name="twitter:title" content="${title}" />
    <meta name="twitter:description" content="piwheels blog" />
  </div>

  <div metal:fill-slot="title" tal:omit-tag="1">${title}</div>

  <section metal:fill-slot="content">
    <div class="content">
      <h2>${title}</h2>
      <div class="small-12 medium-8 columns post" tal:repeat="post site.posts[:10]">
        <div class="postmeta">
          <time datetime="${post.published.isoformat(timespec='seconds')}" title="${post.published.isoformat(timespec='seconds')}">${post.published.strftime("%-d %B %Y")}</time> by ${post.author}
        </div>
        <h3 class="title"><a href="/${post.link}">${post.title}</a></h3>
        <p tal:content="structure post.excerpt"></p>
        <div class="callout primary tags">
          Tags: <a tal:repeat="tag post.tags" href="/tags/${tag}">${tag.replace("-", " ")}</a>
        </div>
      </div>
    </div>

    <div class="sidebar">
      <div>
        <h3>Archive</h3>
        <ul>
          <li><a href="/archive/">Archive</a></li>
          <li><a href="/tags/">Tags</a></li>
          <li tal:repeat="year site.archive.keys()"><a href="/${year}/">${year}</a></li>
        </ul>
      </div>
    </div>
  </section>
</div>